NEXT_PUBLIC_API_URL=/api/v1
BACKEND_PROXY_ORIGIN=http://localhost:5000

# Cloudflare Turnstile site key (public). Get from https://dash.cloudflare.com -> Turnstile.
# Leave blank in development to skip widget rendering — backend will also skip verification.
# Test site keys (Turnstile docs):
#   1x00000000000000000000AA = always passes (visible)
#   2x00000000000000000000AB = always blocks
#   3x00000000000000000000FF = forces an interactive challenge
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
